# Neo4j Aura connection (required for all modules)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password-here
NEO4J_DATABASE=neo4j

# AWS region (Workshop Studio pre-configures credentials; self-paced users set these)
AWS_REGION=us-east-1

# Model override (optional — default is Claude Sonnet)
# MODEL_ID=us.anthropic.claude-sonnet-4-6
